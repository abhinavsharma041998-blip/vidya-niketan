# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vidya-niketan?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRE=7d

# Admin Default Credentials (change after first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

# Twilio SMS & WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Fast2SMS (alternative SMS for India)
FAST2SMS_API_KEY=your_fast2sms_api_key

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Institute Info
INSTITUTE_NAME=Vidya Niketan Education Centre
INSTITUTE_PHONE=+91-XXXXXXXXXX
